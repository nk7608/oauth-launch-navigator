# Copy to .env.local and fill in. Never commit real values. Never paste keys into a chat.
COMPOSIO_API_KEY=
OPENROUTER_API_KEY=
TAVILY_API_KEY=
# Optional: an OpenRouter model id ending in :free (chosen in build step 0d)
LLM_MODEL=
LLM_PROVIDER=openrouter
# Optional: live plans per visitor per hour (default 3)
VISITOR_RUNS_PER_HOUR=3
# Required on Vercel: connect a Blob store with Private access; Vercel supplies this token.
BLOB_READ_WRITE_TOKEN=
# Optional fallbacks (see README "Limits and fallbacks")
# Extra free OpenRouter models to try, comma-separated (default: recursive/flint-v1.0:free,google/gemma-4-31b-it:free)
LLM_FALLBACK_MODELS=
# Optional second AI provider, used only when OpenRouter fails or its daily cap is reached
GROQ_API_KEY=
GROQ_MODEL=
# Owner-only: /api/quota?token=<DEMO_TOKEN> shows today's remaining free requests and unlocks the daily reserve
DEMO_TOKEN=
DAILY_RESERVE=5
