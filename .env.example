# Copy to .env.local and fill in. Never commit real values. Never paste keys into a chat.
COMPOSIO_API_KEY=
OPENROUTER_API_KEY=
TAVILY_API_KEY=
# Optional: an OpenRouter model id ending in :free (chosen in build step 0d)
LLM_MODEL=
LLM_PROVIDER=openrouter
# Optional: comma-separated OpenRouter fallback model IDs (defaults to recursive/flint-v1.0:free)
LLM_FALLBACK_MODELS=
# Optional: live plans per visitor per hour (default 3)
VISITOR_RUNS_PER_HOUR=3
# Required on Vercel: connect a Blob store with Private access; Vercel supplies this token.
BLOB_READ_WRITE_TOKEN=
